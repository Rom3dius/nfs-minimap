// Mobile minimap UI - uses GPS for positioning
// Uses shared components from minimap.slint with HUD enabled

import { MinimapView, RoadSegment, PlayerState, MinimapColors, Poi, AreaTriangle, WaterwaySegment, LaneDisplay, ThemeManager } from "../../../ui/minimap.slint";

export { RoadSegment, PlayerState, Poi, AreaTriangle, WaterwaySegment, LaneDisplay }

export component MobileApp inherits Window {
    title: "NFS Minimap";

    // Properties bound from Rust
    in property <[RoadSegment]> roads <=> map.roads;
    in property <[Poi]> pois <=> map.pois;
    in property <[AreaTriangle]> areas <=> map.areas;
    in property <[WaterwaySegment]> waterways <=> map.waterways;
    in property <PlayerState> player <=> map.player;
    in property <string> status-text: "Waiting for GPS...";
    in property <bool> gps-active: false;

    // Junction view properties
    in property <bool> junction-visible <=> map.junction-visible;
    in property <[LaneDisplay]> junction-lanes <=> map.junction-lanes;
    in property <string> junction-destination <=> map.junction-destination;
    in property <float> junction-distance-m <=> map.junction-distance-m;
    in property <int> junction-turn-type <=> map.junction-turn-type;

    // Zoom callbacks (forwarded to shared MinimapView)
    callback zoom-in <=> map.zoom-in;
    callback zoom-out <=> map.zoom-out;

    background: ThemeManager.colors.bg;

    // Use shared MinimapView with HUD enabled for mobile
    map := MinimapView {
        width: 100%;
        height: 100%;
        show-hud: true;
        gps-active: root.gps-active;
        status-text: root.status-text;
    }
}
