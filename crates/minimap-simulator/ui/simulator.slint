// Simulator wrapper - adds keyboard controls for desktop testing
// Uses shared components from minimap.slint with theming and settings

import { MinimapView, RoadSegment, PlayerState, MinimapColors, Poi, AreaTriangle, WaterwaySegment, ThemeManager, SearchResultItem } from "../../../ui/minimap.slint";

export { RoadSegment, PlayerState, Poi, AreaTriangle, WaterwaySegment, SearchResultItem }

export component SimulatorWindow inherits Window {
    in property <[RoadSegment]> roads <=> map.roads;
    in property <[Poi]> pois <=> map.pois;
    in property <[AreaTriangle]> areas <=> map.areas;
    in property <[WaterwaySegment]> waterways <=> map.waterways;
    in property <PlayerState> player <=> map.player;

    // GPS status: 0 = no signal, 1 = inaccurate, 2 = good (default to good for simulator)
    in property <int> gps-status <=> map.gps-status;

    // Error display
    in-out property <bool> error-visible <=> map.error-visible;
    in property <string> error-message <=> map.error-message;
    callback dismiss-error <=> map.dismiss-error;

    // Search functionality
    in property <[SearchResultItem]> search-results <=> map.search-results;
    callback search <=> map.search;
    callback route-to <=> map.route-to;
    callback clear-route <=> map.clear-route;

    // Keyboard callbacks for movement
    callback key-pressed(string);
    callback key-released(string);

    // Zoom callbacks (forwarded to shared MinimapView)
    callback zoom-in <=> map.zoom-in;
    callback zoom-out <=> map.zoom-out;

    // Theme cycling callback
    callback cycle-theme();

    // Current theme (read-only for Rust)
    out property <int> current-theme: ThemeManager.current-theme;
    out property <string> current-theme-name: ThemeManager.theme-names[ThemeManager.current-theme];

    title: "NFS2 Minimap Simulator";
    background: ThemeManager.colors.bg;
    preferred-width: 800px;
    preferred-height: 800px;

    // Forward focus to keyboard handler for WASD controls
    forward-focus: keyboard-handler;

    // Cycle theme handler
    cycle-theme => {
        ThemeManager.current-theme = mod(ThemeManager.current-theme + 1, 6);
    }

    // Map view
    map := MinimapView {
        width: 100%;
        height: 100%;

        // Refocus keyboard handler when map is tapped
        map-tapped => {
            keyboard-handler.focus();
        }
    }

    // Keyboard handler (initially focused via forward-focus)
    keyboard-handler := FocusScope {
        x: 0;
        y: 0;
        width: 0;
        height: 0;

        key-pressed(event) => {
            key-pressed(event.text);
            accept
        }
        key-released(event) => {
            key-released(event.text);
            accept
        }
    }

}
