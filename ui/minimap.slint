// NFS2-style minimap UI with theming support

// ============================================================================
// Data Structures
// ============================================================================

export struct RoadSegment {
    x1: float,
    y1: float,
    x2: float,
    y2: float,
    road-type: int,  // 0 = primary, 1 = secondary, 2 = highlight
}

export struct Poi {
    x: float,
    y: float,
    poi-type: int,  // 0 = gas station, 1 = parking, 2 = shopping mall, 3 = car wash, 4 = fast food
}

export struct WaterwaySegment {
    x1: float,
    y1: float,
    x2: float,
    y2: float,
    waterway-type: int,  // 0 = river, 1 = stream, 2 = canal
}

export struct AreaTriangle {
    x1: float,
    y1: float,
    x2: float,
    y2: float,
    x3: float,
    y3: float,
    area-type: int,  // 0 = water, 1 = forest, 2 = park, 3 = grass
}

export struct PlayerState {
    heading: float,      // Degrees, 0 = North
    speed-kmh: float,
    latitude: float,
    longitude: float,
}

// Search result from the routing engine
export struct SearchResultItem {
    name: string,
    lat: float,
    lon: float,
    category: string,
    distance-km: float,  // Distance from current position
}

// Theme color structure
export struct ThemeColors {
    bg: color,
    panel-bg: color,
    road-primary: color,
    road-secondary: color,
    road-highlight: color,
    player-color: color,
    text-color: color,
    text-secondary: color,
    accent: color,
    poi-gas: color,
    poi-parking: color,
    poi-mall: color,
    poi-carwash: color,
    poi-fastfood: color,
    area-water: color,
    area-forest: color,
    area-park: color,
    area-grass: color,
}

// ============================================================================
// Theme Definitions
// ============================================================================

export global ThemeManager {
    // Current theme index: 0=NFS2, 1=HelloKitty, 2=Wintergreen, 3=Frappe, 4=Mocha, 5=BlackGold
    in-out property <int> current-theme: 0;

    // Theme names for UI
    out property <[string]> theme-names: ["NFS2 Classic", "Hello Kitty", "Wintergreen", "Catppuccin Frappe", "Catppuccin Mocha", "Black & Gold"];

    // NFS2 Classic (Default)
    out property <ThemeColors> theme-nfs2: {
        bg: #1a1a2e,
        panel-bg: #2a2a4e,
        road-primary: #4a90a4,
        road-secondary: #2d5a6b,
        road-highlight: #e94560,
        player-color: #f39c12,
        text-color: #eeeeee,
        text-secondary: #888888,
        accent: #4a90a4,
        poi-gas: #e74c3c,
        poi-parking: #3498db,
        poi-mall: #9b59b6,
        poi-carwash: #1abc9c,
        poi-fastfood: #f39c12,
        area-water: #1e2a38,
        area-forest: #1a2620,
        area-park: #1e2a22,
        area-grass: #1f2418,
    };

    // Hello Kitty (Pink/Cute)
    out property <ThemeColors> theme-hellokitty: {
        bg: #ffe4ec,
        panel-bg: #ffb6c1,
        road-primary: #ff69b4,
        road-secondary: #ffb6c1,
        road-highlight: #ff1493,
        player-color: #ff0066,
        text-color: #880044,
        text-secondary: #cc6699,
        accent: #ff69b4,
        poi-gas: #ff6b6b,
        poi-parking: #ff8fab,
        poi-mall: #c77dff,
        poi-carwash: #72efdd,
        poi-fastfood: #ffaa00,
        area-water: #b8e0ff,
        area-forest: #98d8aa,
        area-park: #c8e6c9,
        area-grass: #dcedc8,
    };

    // Wintergreen
    out property <ThemeColors> theme-wintergreen: {
        bg: #0d1f17,
        panel-bg: #1a3d2e,
        road-primary: #4f9e81,
        road-secondary: #2f7a5e,
        road-highlight: #89e1c9,
        player-color: #a6e3a1,
        text-color: #e8f5e9,
        text-secondary: #81c784,
        accent: #4f9e81,
        poi-gas: #ef5350,
        poi-parking: #42a5f5,
        poi-mall: #ab47bc,
        poi-carwash: #26c6da,
        poi-fastfood: #ffa726,
        area-water: #1a3a4a,
        area-forest: #1b4332,
        area-park: #2d5a3d,
        area-grass: #1e3a28,
    };

    // Catppuccin Frappe
    out property <ThemeColors> theme-frappe: {
        bg: #303446,
        panel-bg: #414559,
        road-primary: #8caaee,
        road-secondary: #626880,
        road-highlight: #e78284,
        player-color: #f4b8e4,
        text-color: #c6d0f5,
        text-secondary: #a5adce,
        accent: #ca9ee6,
        poi-gas: #e78284,
        poi-parking: #8caaee,
        poi-mall: #ca9ee6,
        poi-carwash: #81c8be,
        poi-fastfood: #ef9f76,
        area-water: #292c3c,
        area-forest: #2a3830,
        area-park: #303840,
        area-grass: #2e3530,
    };

    // Catppuccin Mocha
    out property <ThemeColors> theme-mocha: {
        bg: #1e1e2e,
        panel-bg: #313244,
        road-primary: #89b4fa,
        road-secondary: #585b70,
        road-highlight: #f38ba8,
        player-color: #f5c2e7,
        text-color: #cdd6f4,
        text-secondary: #a6adc8,
        accent: #cba6f7,
        poi-gas: #f38ba8,
        poi-parking: #89b4fa,
        poi-mall: #cba6f7,
        poi-carwash: #94e2d5,
        poi-fastfood: #fab387,
        area-water: #181825,
        area-forest: #1a2520,
        area-park: #1e2830,
        area-grass: #1e2520,
    };

    // Black & Gold
    out property <ThemeColors> theme-blackgold: {
        bg: #0a0a0a,
        panel-bg: #1a1a1a,
        road-primary: #d4af37,
        road-secondary: #8b7355,
        road-highlight: #ffd700,
        player-color: #ffd700,
        text-color: #d4af37,
        text-secondary: #8b7355,
        accent: #d4af37,
        poi-gas: #ff6b35,
        poi-parking: #d4af37,
        poi-mall: #c9a227,
        poi-carwash: #b8860b,
        poi-fastfood: #e6a800,
        area-water: #0d1520,
        area-forest: #101510,
        area-park: #151a10,
        area-grass: #12150d,
    };

    // Active theme (computed based on current-theme)
    out property <ThemeColors> colors: current-theme == 0 ? theme-nfs2 :
                                       current-theme == 1 ? theme-hellokitty :
                                       current-theme == 2 ? theme-wintergreen :
                                       current-theme == 3 ? theme-frappe :
                                       current-theme == 4 ? theme-mocha :
                                       theme-blackgold;
}

// Legacy global for backwards compatibility
export global MinimapColors {
    out property <color> bg: ThemeManager.colors.bg;
    out property <color> road-primary: ThemeManager.colors.road-primary;
    out property <color> road-secondary: ThemeManager.colors.road-secondary;
    out property <color> road-highlight: ThemeManager.colors.road-highlight;
    out property <color> player-color: ThemeManager.colors.player-color;
    out property <color> text-color: ThemeManager.colors.text-color;
    out property <color> poi-gas: ThemeManager.colors.poi-gas;
    out property <color> poi-parking: ThemeManager.colors.poi-parking;
    out property <color> poi-mall: ThemeManager.colors.poi-mall;
    out property <color> poi-carwash: ThemeManager.colors.poi-carwash;
    out property <color> poi-fastfood: ThemeManager.colors.poi-fastfood;
    out property <color> area-water: ThemeManager.colors.area-water;
    out property <color> area-forest: ThemeManager.colors.area-forest;
    out property <color> area-park: ThemeManager.colors.area-park;
    out property <color> area-grass: ThemeManager.colors.area-grass;
    out property <color> waterway-river: ThemeManager.colors.area-water;
    out property <color> waterway-stream: ThemeManager.colors.area-water;
    out property <color> waterway-canal: ThemeManager.colors.area-water;
}

// ============================================================================
// Settings Panel Component
// ============================================================================

component SettingsPanel inherits Rectangle {
    in-out property <bool> panel-open: false;
    callback close();

    width: 100%;
    height: 100%;
    background: panel-open ? #00000080 : transparent;

    // Block touches when open
    TouchArea {
        enabled: parent.panel-open;
        clicked => { close(); }
    }

    // Settings dialog
    Rectangle {
        visible: parent.panel-open;
        width: min(280px, parent.width - 40px);
        height: min(420px, parent.height - 60px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: ThemeManager.colors.panel-bg;
        border-radius: 16px;
        clip: true;

        TouchArea {
            // Prevent clicks from closing when clicking on panel
            clicked => { }
        }

        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            // Header
            HorizontalLayout {
                height: 32px;
                alignment: space-between;

                Text {
                    text: "Settings";
                    font-size: 18px;
                    font-weight: 700;
                    color: ThemeManager.colors.text-color;
                    vertical-alignment: center;
                }

                // Close button
                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 14px;
                    background: ThemeManager.colors.bg;

                    Text {
                        text: "×";
                        font-size: 18px;
                        font-weight: 700;
                        color: ThemeManager.colors.text-color;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        clicked => { close(); }
                    }
                }
            }

            // Themes section label
            Text {
                text: "Theme";
                font-size: 12px;
                font-weight: 600;
                color: ThemeManager.colors.text-secondary;
            }

            // Scrollable theme list
            Flickable {
                viewport-height: 6 * 40px + 5 * 8px; // 6 themes * height + spacing

                VerticalLayout {
                    spacing: 8px;

                    // Theme buttons
                    for theme[index] in ThemeManager.theme-names: Rectangle {
                        height: 40px;
                        background: ThemeManager.current-theme == index ? ThemeManager.colors.accent : ThemeManager.colors.bg;
                        border-radius: 8px;
                        border-width: ThemeManager.current-theme == index ? 2px : 1px;
                        border-color: ThemeManager.current-theme == index ? ThemeManager.colors.accent : ThemeManager.colors.text-secondary;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: start;

                            Text {
                                text: theme;
                                font-size: 13px;
                                color: ThemeManager.current-theme == index ?
                                       (ThemeManager.current-theme == 1 ? #880044 : ThemeManager.colors.bg) :
                                       ThemeManager.colors.text-color;
                                vertical-alignment: center;
                            }
                        }

                        TouchArea {
                            clicked => {
                                ThemeManager.current-theme = index;
                            }
                        }
                    }
                }
            }
        }
    }
}

// ============================================================================
// Gear Button Component
// ============================================================================

component GearButton inherits Rectangle {
    in property <bool> show: false;
    callback clicked();

    width: 44px;
    height: 44px;
    border-radius: 22px;
    background: ThemeManager.colors.panel-bg;
    opacity: show ? 0.9 : 0;

    animate opacity { duration: 300ms; }

    // Gear icon (simplified)
    Path {
        x: 10px;
        y: 10px;
        width: 24px;
        height: 24px;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: ThemeManager.colors.text-color;

        // Outer gear teeth
        MoveTo { x: 12; y: 2; }
        LineTo { x: 14; y: 2; }
        LineTo { x: 14.5; y: 5; }
        LineTo { x: 17; y: 6; }
        LineTo { x: 19.5; y: 4; }
        LineTo { x: 21; y: 5.5; }
        LineTo { x: 19; y: 8; }
        LineTo { x: 20; y: 10.5; }
        LineTo { x: 23; y: 11; }
        LineTo { x: 23; y: 13; }
        LineTo { x: 20; y: 13.5; }
        LineTo { x: 19; y: 16; }
        LineTo { x: 21; y: 18.5; }
        LineTo { x: 19.5; y: 20; }
        LineTo { x: 17; y: 18; }
        LineTo { x: 14.5; y: 19; }
        LineTo { x: 14; y: 22; }
        LineTo { x: 10; y: 22; }
        LineTo { x: 9.5; y: 19; }
        LineTo { x: 7; y: 18; }
        LineTo { x: 4.5; y: 20; }
        LineTo { x: 3; y: 18.5; }
        LineTo { x: 5; y: 16; }
        LineTo { x: 4; y: 13.5; }
        LineTo { x: 1; y: 13; }
        LineTo { x: 1; y: 11; }
        LineTo { x: 4; y: 10.5; }
        LineTo { x: 5; y: 8; }
        LineTo { x: 3; y: 5.5; }
        LineTo { x: 4.5; y: 4; }
        LineTo { x: 7; y: 6; }
        LineTo { x: 9.5; y: 5; }
        Close {}
    }

    // Center circle (hole in gear)
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: ThemeManager.colors.panel-bg;
    }

    TouchArea {
        enabled: parent.show;
        clicked => { root.clicked(); }
    }
}

// ============================================================================
// Info Button Component
// ============================================================================

component InfoButton inherits Rectangle {
    in property <bool> show: false;
    callback clicked();

    width: 44px;
    height: 44px;
    border-radius: 22px;
    background: ThemeManager.colors.panel-bg;
    opacity: show ? 0.9 : 0;

    animate opacity { duration: 300ms; }

    // Info icon: circle with "i"
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 24px;
        height: 24px;
        border-radius: 12px;
        border-width: 2px;
        border-color: ThemeManager.colors.text-color;
        background: transparent;

        // Letter "i"
        Text {
            text: "i";
            font-size: 16px;
            font-weight: 700;
            font-italic: true;
            color: ThemeManager.colors.text-color;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    TouchArea {
        enabled: parent.show;
        clicked => { root.clicked(); }
    }
}

// ============================================================================
// Legend Panel Component
// ============================================================================

component LegendItem inherits HorizontalLayout {
    in property <color> item-color;
    in property <string> label;
    in property <bool> is-line: false;
    in property <bool> is-poi: false;

    spacing: 10px;
    height: 24px;

    // Color indicator
    Rectangle {
        width: 24px;
        height: is-line ? 4px : 16px;
        y: is-line ? (parent.height - self.height) / 2 : (parent.height - self.height) / 2;
        border-radius: is-poi ? 8px : (is-line ? 2px : 3px);
        background: item-color;
        border-width: is-poi ? 2px : 0;
        border-color: #fff;
    }

    // Label
    Text {
        text: label;
        font-size: 12px;
        color: ThemeManager.colors.text-color;
        vertical-alignment: center;
    }
}

component LegendPanel inherits Rectangle {
    in-out property <bool> panel-open: false;
    callback close();

    width: 100%;
    height: 100%;
    background: panel-open ? #00000080 : transparent;

    // Block touches when open
    TouchArea {
        enabled: parent.panel-open;
        clicked => { close(); }
    }

    // Legend dialog
    Rectangle {
        visible: parent.panel-open;
        width: min(260px, parent.width - 40px);
        height: min(480px, parent.height - 60px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: ThemeManager.colors.panel-bg;
        border-radius: 16px;
        clip: true;

        TouchArea {
            clicked => { }
        }

        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            // Header
            HorizontalLayout {
                height: 32px;
                alignment: space-between;

                Text {
                    text: "Legend";
                    font-size: 18px;
                    font-weight: 700;
                    color: ThemeManager.colors.text-color;
                    vertical-alignment: center;
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 14px;
                    background: ThemeManager.colors.bg;

                    Text {
                        text: "×";
                        font-size: 18px;
                        font-weight: 700;
                        color: ThemeManager.colors.text-color;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        clicked => { close(); }
                    }
                }
            }

            // Scrollable content
            Flickable {
                viewport-height: 550px;

                VerticalLayout {
                    spacing: 16px;

                    // Roads section
                    VerticalLayout {
                        spacing: 6px;

                        Text {
                            text: "Roads";
                            font-size: 12px;
                            font-weight: 600;
                            color: ThemeManager.colors.text-secondary;
                        }

                        LegendItem {
                            item-color: ThemeManager.colors.road-primary;
                            label: "Primary Road";
                            is-line: true;
                        }
                        LegendItem {
                            item-color: ThemeManager.colors.road-secondary;
                            label: "Secondary Road";
                            is-line: true;
                        }
                        LegendItem {
                            item-color: ThemeManager.colors.road-highlight;
                            label: "Highlighted Route";
                            is-line: true;
                        }
                    }

                    // Waterways section
                    VerticalLayout {
                        spacing: 6px;

                        Text {
                            text: "Waterways";
                            font-size: 12px;
                            font-weight: 600;
                            color: ThemeManager.colors.text-secondary;
                        }

                        LegendItem {
                            item-color: ThemeManager.colors.area-water;
                            label: "River / Canal";
                            is-line: true;
                        }
                        LegendItem {
                            item-color: ThemeManager.colors.area-water;
                            label: "Stream";
                            is-line: true;
                        }
                    }

                    // Areas section
                    VerticalLayout {
                        spacing: 6px;

                        Text {
                            text: "Areas";
                            font-size: 12px;
                            font-weight: 600;
                            color: ThemeManager.colors.text-secondary;
                        }

                        LegendItem {
                            item-color: ThemeManager.colors.area-water;
                            label: "Water / Lake";
                        }
                        LegendItem {
                            item-color: ThemeManager.colors.area-forest;
                            label: "Forest";
                        }
                        LegendItem {
                            item-color: ThemeManager.colors.area-park;
                            label: "Park";
                        }
                        LegendItem {
                            item-color: ThemeManager.colors.area-grass;
                            label: "Grassland";
                        }
                    }

                    // POIs section
                    VerticalLayout {
                        spacing: 6px;

                        Text {
                            text: "Points of Interest";
                            font-size: 12px;
                            font-weight: 600;
                            color: ThemeManager.colors.text-secondary;
                        }

                        LegendItem {
                            item-color: ThemeManager.colors.poi-gas;
                            label: "Gas Station";
                            is-poi: true;
                        }
                        LegendItem {
                            item-color: ThemeManager.colors.poi-parking;
                            label: "Parking";
                            is-poi: true;
                        }
                        LegendItem {
                            item-color: ThemeManager.colors.poi-mall;
                            label: "Shopping Mall";
                            is-poi: true;
                        }
                        LegendItem {
                            item-color: ThemeManager.colors.poi-carwash;
                            label: "Car Wash";
                            is-poi: true;
                        }
                        LegendItem {
                            item-color: ThemeManager.colors.poi-fastfood;
                            label: "Fast Food";
                            is-poi: true;
                        }
                    }

                    // Player marker
                    VerticalLayout {
                        spacing: 6px;

                        Text {
                            text: "Vehicle";
                            font-size: 12px;
                            font-weight: 600;
                            color: ThemeManager.colors.text-secondary;
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            height: 24px;

                            // Triangle marker
                            Rectangle {
                                width: 24px;
                                height: 16px;
                                y: (parent.height - self.height) / 2;
                                background: transparent;

                                Path {
                                    width: 100%;
                                    height: 100%;
                                    fill: ThemeManager.colors.player-color;
                                    stroke: #fff;
                                    stroke-width: 1px;
                                    MoveTo { x: 12; y: 0; }
                                    LineTo { x: 0; y: 16; }
                                    LineTo { x: 24; y: 16; }
                                    Close {}
                                }
                            }

                            Text {
                                text: "Your Position";
                                font-size: 12px;
                                color: ThemeManager.colors.text-color;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}

// ============================================================================
// Error Popup Component (centered for round display)
// ============================================================================

component ErrorPopup inherits Rectangle {
    in-out property <bool> popup-visible: false;
    in property <string> message: "";
    callback dismiss();

    width: 100%;
    height: 100%;
    background: popup-visible ? #000000a0 : transparent;

    // Block touches when visible
    TouchArea {
        enabled: root.popup-visible;
        clicked => { dismiss(); }
    }

    // Error dialog - centered circle for round display
    Rectangle {
        visible: root.popup-visible;
        width: min(300px, parent.width - 60px);
        height: self.width;  // Keep it square/circular
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: ThemeManager.colors.panel-bg;
        border-radius: self.width / 2;  // Make it circular
        border-width: 3px;
        border-color: #e74c3c;  // Red border for error

        TouchArea {
            // Prevent clicks from dismissing when clicking on popup
            clicked => { }
        }

        VerticalLayout {
            padding: 40px;
            spacing: 16px;
            alignment: center;

            // Error icon
            Text {
                text: "!";
                font-size: 48px;
                font-weight: 900;
                color: #e74c3c;
                horizontal-alignment: center;
            }

            // Error title
            Text {
                text: "Error";
                font-size: 18px;
                font-weight: 700;
                color: ThemeManager.colors.text-color;
                horizontal-alignment: center;
            }

            // Error message
            Text {
                text: message;
                font-size: 13px;
                color: ThemeManager.colors.text-secondary;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            // Dismiss button
            Rectangle {
                width: 100px;
                height: 36px;
                background: #e74c3c;
                border-radius: 18px;

                Text {
                    text: "Dismiss";
                    font-size: 14px;
                    font-weight: 600;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    clicked => { dismiss(); }
                }
            }
        }
    }
}

// ============================================================================
// Zoom Controls Component
// ============================================================================

component ZoomControls inherits VerticalLayout {
    callback zoom-in();
    callback zoom-out();

    spacing: 10px;

    // Zoom in button
    Rectangle {
        width: 44px;
        height: 44px;
        border-radius: 22px;
        background: ThemeManager.colors.panel-bg;
        border-width: 2px;
        border-color: ThemeManager.colors.accent;

        Text {
            text: "+";
            color: ThemeManager.colors.text-color;
            font-size: 24px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        TouchArea {
            clicked => { zoom-in(); }
        }
    }

    // Zoom out button
    Rectangle {
        width: 44px;
        height: 44px;
        border-radius: 22px;
        background: ThemeManager.colors.panel-bg;
        border-width: 2px;
        border-color: ThemeManager.colors.accent;

        Text {
            text: "-";
            color: ThemeManager.colors.text-color;
            font-size: 24px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        TouchArea {
            clicked => { zoom-out(); }
        }
    }
}

// ============================================================================
// Search Button Component
// ============================================================================

component SearchButton inherits Rectangle {
    in property <bool> show: false;
    callback clicked();

    width: 44px;
    height: 44px;
    border-radius: 22px;
    background: ThemeManager.colors.panel-bg;
    opacity: show ? 0.9 : 0;

    animate opacity { duration: 300ms; }

    // Magnifying glass icon using Path
    Path {
        x: 10px;
        y: 10px;
        width: 24px;
        height: 24px;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: ThemeManager.colors.text-color;
        stroke-width: 2.5px;
        fill: transparent;

        // Circle part
        MoveTo { x: 17; y: 10; }
        ArcTo { x: 3; y: 10; radius-x: 7; radius-y: 7; }
        ArcTo { x: 17; y: 10; radius-x: 7; radius-y: 7; }

        // Handle
        MoveTo { x: 15; y: 15; }
        LineTo { x: 21; y: 21; }
    }

    TouchArea {
        enabled: parent.show;
        clicked => { root.clicked(); }
    }
}

// ============================================================================
// Search Panel Component
// ============================================================================

component SearchPanel inherits Rectangle {
    in-out property <bool> panel-open: false;
    in property <[SearchResultItem]> results: [];
    in-out property <string> query: "";
    callback close();
    callback search(string);
    callback route-to(float, float);  // lat, lon

    width: 100%;
    height: 100%;
    background: panel-open ? #00000080 : transparent;

    // Block touches when open
    TouchArea {
        enabled: parent.panel-open;
        clicked => { close(); }
    }

    // Search dialog
    Rectangle {
        visible: parent.panel-open;
        width: min(320px, parent.width - 40px);
        height: min(400px, parent.height - 60px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: ThemeManager.colors.panel-bg;
        border-radius: 16px;
        clip: true;

        TouchArea {
            clicked => { }
        }

        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            // Header
            HorizontalLayout {
                height: 32px;
                alignment: space-between;

                Text {
                    text: "Search";
                    font-size: 18px;
                    font-weight: 700;
                    color: ThemeManager.colors.text-color;
                    vertical-alignment: center;
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 14px;
                    background: ThemeManager.colors.bg;

                    Text {
                        text: "×";
                        font-size: 18px;
                        font-weight: 700;
                        color: ThemeManager.colors.text-color;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        clicked => { close(); }
                    }
                }
            }

            // Search input
            Rectangle {
                height: 40px;
                background: ThemeManager.colors.bg;
                border-radius: 8px;
                border-width: 1px;
                border-color: ThemeManager.colors.text-secondary;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 8px;
                    spacing: 8px;

                    search-input := TextInput {
                        vertical-alignment: center;
                        font-size: 14px;
                        color: ThemeManager.colors.text-color;
                        text <=> query;
                        accepted => { search(self.text); }
                    }

                    // Search button
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 6px;
                        background: ThemeManager.colors.accent;

                        Text {
                            text: "→";
                            font-size: 16px;
                            font-weight: 700;
                            color: ThemeManager.colors.bg;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            clicked => { search(search-input.text); }
                        }
                    }
                }
            }

            // Results list
            Flickable {
                viewport-height: results.length * 56px;

                VerticalLayout {
                    spacing: 4px;

                    for result[index] in results: Rectangle {
                        height: 52px;
                        background: ThemeManager.colors.bg;
                        border-radius: 8px;

                        VerticalLayout {
                            padding: 8px;
                            padding-left: 12px;
                            spacing: 2px;

                            Text {
                                text: result.name;
                                font-size: 13px;
                                color: ThemeManager.colors.text-color;
                                overflow: elide;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: result.category;
                                    font-size: 11px;
                                    color: ThemeManager.colors.text-secondary;
                                }
                                Text {
                                    text: result.distance-km < 1.0
                                        ? round(result.distance-km * 1000) + " m"
                                        : round(result.distance-km * 10) / 10 + " km";
                                    font-size: 11px;
                                    color: ThemeManager.colors.accent;
                                }
                            }
                        }

                        TouchArea {
                            clicked => {
                                route-to(result.lat, result.lon);
                                close();
                            }
                        }
                    }

                    // Empty state - only show after search is performed
                    if results.length == 0: Text {
                        text: "Type a place name and press Enter";
                        font-size: 13px;
                        color: ThemeManager.colors.text-secondary;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }
}

// ============================================================================
// Main Minimap View Component
// ============================================================================

export component MinimapView inherits Rectangle {
    in property <[RoadSegment]> roads: [];
    in property <[Poi]> pois: [];
    in property <[AreaTriangle]> areas: [];
    in property <[WaterwaySegment]> waterways: [];
    in property <PlayerState> player: { heading: 0, speed-kmh: 0, latitude: 0, longitude: 0 };

    // GPS status: 0 = no signal (red ring), 1 = inaccurate (yellow ring), 2 = good (no ring)
    in property <int> gps-status: 0;

    // Error display
    in-out property <bool> error-visible: false;
    in property <string> error-message: "";
    callback dismiss-error();

    // Zoom callbacks
    callback zoom-in();
    callback zoom-out();

    // Search callbacks and properties
    in property <[SearchResultItem]> search-results: [];
    callback search(string);
    callback route-to(float, float);
    callback clear-route();

    // Called when map is tapped (for focus management)
    callback map-tapped();

    // UI visibility state
    property <bool> settings-open: false;
    property <bool> legend-open: false;
    property <bool> search-open: false;
    property <string> search-query: "";

    // Helper: any panel open
    property <bool> any-panel-open: settings-open || legend-open || search-open;

    // Auto-hide mechanism:
    // - click-count toggles between odd/even
    // - cycle-value animates between 0 and 1 over 4 seconds
    // - UI is visible while cycle-value is animating (between 0.01 and 0.99)
    // - When animation completes (reaches 0 or 1), UI auto-hides
    property <int> click-count: 0;
    property <float> cycle-value: mod(click-count, 2) == 1 ? 1.0 : 0.0;
    animate cycle-value {
        duration: 4000ms;  // Buttons visible for ~4 seconds
        easing: linear;
    }

    // UI visible while animating OR while a panel is open
    property <bool> ui-visible: any-panel-open || (cycle-value > 0.01 && cycle-value < 0.99);

    background: ThemeManager.colors.bg;

    // Interaction detection - increment click-count to restart animation
    TouchArea {
        clicked => {
            if (!any-panel-open) {
                click-count += 1;
            }
            // Always notify parent for focus management
            map-tapped();
        }
    }

    // Main map area (fills the entire view)
    Rectangle {
        width: 100%;
        height: 100%;

        // GPS status ring (behind the map)
        Rectangle {
            property <length> size: min(parent.width, parent.height);
            width: size;
            height: size;
            x: (parent.width - size) / 2;
            y: (parent.height - size) / 2;
            border-radius: size / 2;
            background: transparent;
            // Ring thickness and color based on GPS status
            border-width: gps-status == 2 ? 0px : 4px;
            border-color: gps-status == 0 ? #e74c3c : #f1c40f;  // Red or Yellow
        }

        // Map canvas
        Rectangle {
            property <length> size: min(parent.width, parent.height) - 8px;  // Slightly smaller to show ring
            width: size;
            height: size;
            x: (parent.width - size) / 2;
            y: (parent.height - size) / 2;
            background: ThemeManager.colors.bg;
            clip: true;
            border-radius: size / 2;

            // Area rendering layer
            for tri in areas: Path {
                width: 100%;
                height: 100%;
                viewbox-x: 0;
                viewbox-y: 0;
                viewbox-width: 800;
                viewbox-height: 800;
                fill: tri.area-type == 0 ? ThemeManager.colors.area-water :
                      tri.area-type == 1 ? ThemeManager.colors.area-forest :
                      tri.area-type == 2 ? ThemeManager.colors.area-park :
                      ThemeManager.colors.area-grass;
                stroke-width: 0px;
                MoveTo { x: tri.x1; y: tri.y1; }
                LineTo { x: tri.x2; y: tri.y2; }
                LineTo { x: tri.x3; y: tri.y3; }
                Close {}
            }

            // Waterway rendering layer
            for ww in waterways: Path {
                width: 100%;
                height: 100%;
                viewbox-x: 0;
                viewbox-y: 0;
                viewbox-width: 800;
                viewbox-height: 800;
                stroke: ThemeManager.colors.area-water;
                stroke-width: ww.waterway-type == 0 ? 5px : ww.waterway-type == 1 ? 2px : 4px;
                MoveTo { x: ww.x1; y: ww.y1; }
                LineTo { x: ww.x2; y: ww.y2; }
            }

            // Road rendering layer
            for segment in roads: Path {
                width: 100%;
                height: 100%;
                viewbox-x: 0;
                viewbox-y: 0;
                viewbox-width: 800;
                viewbox-height: 800;
                stroke: segment.road-type == 0 ? ThemeManager.colors.road-primary :
                        segment.road-type == 1 ? ThemeManager.colors.road-secondary :
                        ThemeManager.colors.road-highlight;
                stroke-width: segment.road-type == 0 ? 4px : segment.road-type == 1 ? 2px : 6px;
                MoveTo { x: segment.x1; y: segment.y1; }
                LineTo { x: segment.x2; y: segment.y2; }
            }

            // POI markers
            property <float> scale-factor: self.size / 800px;
            for poi in pois: Rectangle {
                property <length> poi-x: poi.x * 1px * parent.scale-factor;
                property <length> poi-y: poi.y * 1px * parent.scale-factor;
                width: 14px;
                height: 14px;
                x: poi-x - self.width / 2;
                y: poi-y - self.height / 2;
                border-radius: 7px;
                background: poi.poi-type == 0 ? ThemeManager.colors.poi-gas :
                            poi.poi-type == 1 ? ThemeManager.colors.poi-parking :
                            poi.poi-type == 2 ? ThemeManager.colors.poi-mall :
                            poi.poi-type == 3 ? ThemeManager.colors.poi-carwash :
                            ThemeManager.colors.poi-fastfood;
                border-width: 2px;
                border-color: #fff;
            }

            // Player marker
            Rectangle {
                width: 12px;
                height: 12px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                Path {
                    width: 100%;
                    height: 100%;
                    fill: ThemeManager.colors.player-color;
                    stroke: #fff;
                    stroke-width: 1px;
                    MoveTo { x: 6; y: 0; }
                    LineTo { x: 0; y: 12; }
                    LineTo { x: 12; y: 12; }
                    Close {}
                }
            }

            // Compass letters
            property <length> compass-radius: self.size / 2 - 30px;
            property <angle> heading-angle: -player.heading * 1deg;

            Text {
                property <angle> angle: parent.heading-angle;
                x: parent.width / 2 - self.width / 2 + parent.compass-radius * sin(angle);
                y: parent.height / 2 - self.height / 2 - parent.compass-radius * cos(angle);
                text: "N";
                font-size: 24px;
                font-weight: 700;
                color: ThemeManager.colors.text-color;
            }

            Text {
                property <angle> angle: parent.heading-angle + 180deg;
                x: parent.width / 2 - self.width / 2 + parent.compass-radius * sin(angle);
                y: parent.height / 2 - self.height / 2 - parent.compass-radius * cos(angle);
                text: "S";
                font-size: 24px;
                font-weight: 700;
                color: ThemeManager.colors.text-color;
            }

            Text {
                property <angle> angle: parent.heading-angle + 90deg;
                x: parent.width / 2 - self.width / 2 + parent.compass-radius * sin(angle);
                y: parent.height / 2 - self.height / 2 - parent.compass-radius * cos(angle);
                text: "E";
                font-size: 24px;
                font-weight: 700;
                color: ThemeManager.colors.text-color;
            }

            Text {
                property <angle> angle: parent.heading-angle - 90deg;
                x: parent.width / 2 - self.width / 2 + parent.compass-radius * sin(angle);
                y: parent.height / 2 - self.height / 2 - parent.compass-radius * cos(angle);
                text: "W";
                font-size: 24px;
                font-weight: 700;
                color: ThemeManager.colors.text-color;
            }
        }

        // Gear button (top-left)
        GearButton {
            x: 15px;
            y: 15px;
            show: ui-visible && !any-panel-open;
            clicked => { settings-open = true; }
        }

        // Info button (top-left, below gear)
        InfoButton {
            x: 15px;
            y: 15px + 44px + 10px;
            show: ui-visible && !any-panel-open;
            clicked => { legend-open = true; }
        }

        // Search button (top-left, below info)
        SearchButton {
            x: 15px;
            y: 15px + 44px + 10px + 44px + 10px;
            show: ui-visible && !any-panel-open;
            clicked => { search-open = true; }
        }

        // Zoom controls (right side, centered)
        ZoomControls {
            x: parent.width - 44px - 15px;
            y: (parent.height - self.preferred-height) / 2;
            visible: ui-visible && !any-panel-open;
            zoom-in => { root.zoom-in(); }
            zoom-out => { root.zoom-out(); }
        }
    }

    // Settings overlay
    SettingsPanel {
        panel-open: settings-open;
        close => { settings-open = false; }
    }

    // Legend overlay
    LegendPanel {
        panel-open: legend-open;
        close => { legend-open = false; }
    }

    // Search overlay
    SearchPanel {
        panel-open: search-open;
        query <=> search-query;
        results: search-results;
        close => { search-open = false; }
        search(query) => {
            root.search(query);
        }
        route-to(lat, lon) => { root.route-to(lat, lon); }
    }

    // Error popup (shown on top of everything)
    ErrorPopup {
        popup-visible: error-visible;
        message: error-message;
        dismiss => {
            error-visible = false;
            root.dismiss-error();
        }
    }

}

// ============================================================================
// Window wrapper for standalone use (ESP32)
// ============================================================================

export component Minimap inherits Window {
    in property <[RoadSegment]> roads <=> view.roads;
    in property <[Poi]> pois <=> view.pois;
    in property <[AreaTriangle]> areas <=> view.areas;
    in property <[WaterwaySegment]> waterways <=> view.waterways;
    in property <PlayerState> player <=> view.player;
    in property <int> gps-status <=> view.gps-status;

    callback zoom-in <=> view.zoom-in;
    callback zoom-out <=> view.zoom-out;

    title: "NFS2 Minimap";
    background: ThemeManager.colors.bg;
    preferred-width: 800px;
    preferred-height: 800px;
    min-width: 400px;
    min-height: 400px;

    view := MinimapView {
        width: 100%;
        height: 100%;
    }
}
