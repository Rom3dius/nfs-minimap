    <string>NFS Minimap needs your location to show your position on the map while driving.</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>NFS Minimap needs your location to show your position on the map while driving.</string>
    <key>UIBackgroundModes</key>
    <array>
        <string>location</string>
    </array>
</dict>
</plist>
